APP_NAME=Animato Studio
HOST=0.0.0.0
PORT=8000

# Output video settings
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
FPS=30

# Upload limit
MAX_UPLOAD_MB=200

# Storage
DATA_DIR=/home/cook/Documents/Dev/Dev-365/animato/app/data
STATIC_DIR=/home/cook/Documents/Dev/Dev-365/animato/app/static

# Provider: mock | openai
PROVIDER=openai

# OpenAI Settings (Compatible with other providers like Groq/together.ai)
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=whisper-1
DALLE_MODEL=dall-e-3


